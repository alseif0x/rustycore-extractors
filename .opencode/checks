#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/environment.sh"
if [[ $# -ne 1 ]]; then
  printf '%s\n' 'Uso: .opencode/checks {fmt-check|fmt|rust|clippy|db2|synthetic|contracts|conformance|provenance|cpp|native|live|live-extract}' >&2
  exit 2
fi

run_mode() {
  case "$1" in
    fmt-check) cargo fmt --all -- --check ;;
    fmt) cargo fmt --all ;;
    rust) cargo test --offline --locked --workspace --all-targets ;;
    clippy) cargo clippy --offline --locked --workspace --all-targets -- -D warnings ;;
    db2) cargo build --offline --locked --bin forever-db2-inspect ;;
    synthetic)
      cargo build --offline --locked --bin forever-db2-inspect
      export FOREVER_DB2_INSPECT="$CARGO_TARGET_DIR/debug/forever-db2-inspect"
      python3 -m unittest discover -s tests/forever -p 'test_*.py' -v ;;
    contracts) python3 -m unittest discover -s tests/contracts -p 'test_*.py' -v ;;
    conformance) python3 -m unittest discover -s tests/conformance -p 'test_*.py' -v ;;
    provenance) python3 tests/provenance/test_source_closure.py ;;
    cpp)
      rce_cpp_build="$RCE_OPENCODE_WORK/builds/cpp-opencode"
      cmake -S "$RCE_OPENCODE_ROOT" -B "$rce_cpp_build" -DCMAKE_BUILD_TYPE=Release
      cmake --build "$rce_cpp_build" --parallel "$CARGO_BUILD_JOBS"
      ctest --test-dir "$rce_cpp_build" --output-on-failure ;;
    native)
      if [[ -z "${RCE_FOREVER_CASC_REFERENCE:-}" ]]; then
        printf '%s\n' 'Native requiere RCE_FOREVER_CASC_REFERENCE: checkout local ya auditado y fijado por el proyecto. No se descarga automáticamente.' >&2
        return 2
      fi
      cargo test --offline --locked -p forever-casc --features native
      cargo build --offline --locked -p forever-casc --features native
      export FOREVER_CASC_PROBE="$CARGO_TARGET_DIR/debug/forever-casc-probe"
      export FOREVER_DB2_EXTRACT="$CARGO_TARGET_DIR/debug/forever-db2-extract"
      export FOREVER_DB2_INSPECT="$CARGO_TARGET_DIR/debug/forever-db2-inspect"
      cargo build --offline --locked --bin forever-db2-inspect
      python3 -m unittest discover -s tests/forever -p 'test_*.py' -v ;;
    live|live-extract)
      if [[ "$1" == "live-extract" ]]; then
        cargo build --offline --locked -p forever-casc --features native --bin forever-db2-extract
      else
        cargo build --offline --locked -p forever-casc --features native
      fi
      cargo build --offline --locked --bin forever-db2-inspect
      export FOREVER_CASC_PROBE="$CARGO_TARGET_DIR/debug/forever-casc-probe"
      export FOREVER_DB2_EXTRACT="$CARGO_TARGET_DIR/debug/forever-db2-extract"
      export FOREVER_DB2_INSPECT="$CARGO_TARGET_DIR/debug/forever-db2-inspect"
      python3 .opencode/live-check.py "$1" ;;
    *) printf '%s\n' "Modo desconocido: $1" >&2; return 2 ;;
  esac
}

# The full output goes to an external log; agents receive a bounded summary
# (complete output when short) plus the log path, keeping model context small.
rce_checks_logs="$RCE_OPENCODE_WORK/reports/opencode/checks"
mkdir -p -- "$rce_checks_logs"
rce_checks_log="$rce_checks_logs/$1-$(date -u +%Y%m%dT%H%M%SZ)-$$.log"
export CARGO_TERM_COLOR=never
set +e
( set -euo pipefail; run_mode "$1" ) >"$rce_checks_log" 2>&1
rce_checks_status=$?
set -e
rce_checks_lines=$(wc -l <"$rce_checks_log")
if (( rce_checks_lines <= 150 )); then
  cat -- "$rce_checks_log"
else
  printf '%s\n' "--- resumen (${rce_checks_lines} líneas en el log) ---"
  grep -E '^(test result:|error(\[E[0-9]+\])?:|warning: unused|FAILED|failures:|---- .* ----|thread .* panicked|Ran [0-9]+ tests?|OK( \(|$)|FAIL:|ERROR:|[0-9]+% tests passed|The following tests FAILED)' \
    "$rce_checks_log" | head -n 120 || true
  printf '%s\n' '--- final del log ---'
  tail -n 40 -- "$rce_checks_log"
fi
printf 'checks: modo=%s salida=%d log=%s\n' "$1" "$rce_checks_status" "$rce_checks_log"
exit "$rce_checks_status"
