{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alseif0x/rustycore-extractors/schemas/forever-manifest-v2.schema.json",
  "title": "RustyCore Extractors Forever manifest v2",
  "description": "Forever 1.60.1 (builds 70170/70205) explicit local DB2 batch manifest. This is a NEW, separate contract line and does not re-label or extend the legacy 3.4.3/51943 v1 data-manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "run_id",
    "status",
    "compatibility",
    "client",
    "extractor",
    "scope",
    "formats",
    "options",
    "network",
    "outputs",
    "timestamps",
    "privacy"
  ],
  "properties": {
    "manifest_version": { "const": 2 },
    "run_id": { "$ref": "#/$defs/uuid" },
    "status": { "enum": ["complete", "incomplete", "failed"] },
    "reason": { "type": "string", "minLength": 1 },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support", "target_build"],
      "properties": {
        "support": { "enum": ["admitted", "experimental"] },
        "target_build": { "enum": [70170, 70205] },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "support": { "const": "experimental" } },
            "required": ["support"]
          },
          "then": { "required": ["reason"] },
          "else": { "not": { "required": ["reason"] } }
        }
      ]
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version", "build", "locale", "install_fingerprint_sha256"],
      "properties": {
        "product": { "const": "wow_classic_beta" },
        "version": { "enum": ["1.60.1.70170", "1.60.1.70205"] },
        "build": { "enum": [70170, 70205] },
        "locale": { "enum": ["enUS", "esES"] },
        "install_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "build": { "const": 70170 } },
            "required": ["build"]
          },
          "then": { "properties": { "version": { "const": "1.60.1.70170" } } }
        },
        {
          "if": {
            "properties": { "build": { "const": 70205 } },
            "required": ["build"]
          },
          "then": { "properties": { "version": { "const": "1.60.1.70205" } } }
        }
      ]
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "commit", "implementation", "compatibility_oracle_commit"],
      "properties": {
        "name": { "const": "rustycore-extractors" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "commit": { "$ref": "#/$defs/git_commit" },
        "implementation": { "const": "rust" },
        "compatibility_oracle_commit": { "const": "02245dcd245e7433e524577656177723d3e4992e" }
      }
    },
    "scope": { "const": "explicit_db2_batch" },
    "formats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["db2", "tables"],
      "properties": {
        "db2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["magic", "version"],
          "properties": {
            "magic": { "const": "WDC5" },
            "version": { "const": 5 }
          }
        },
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/table" }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "table_selection",
        "manifest_sha256",
        "entry_count",
        "max_file_bytes",
        "max_batch_bytes"
      ],
      "properties": {
        "locale": { "enum": ["enUS", "esES"] },
        "table_selection": { "enum": ["default_character_tables", "explicit_manifest"] },
        "manifest_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "entry_count": { "type": "integer", "minimum": 1, "maximum": 256 },
        "max_file_bytes": { "const": 16777216 },
        "max_batch_bytes": { "const": 268435456 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "table_selection": { "const": "default_character_tables" } },
            "required": ["table_selection"]
          },
          "then": { "properties": { "manifest_sha256": { "type": "null" } } },
          "else": { "properties": { "manifest_sha256": { "$ref": "#/$defs/sha256" } } }
        }
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allow_network", "remote_casc", "lock_sha256", "downloaded_bytes"],
      "properties": {
        "mode": { "const": "local" },
        "allow_network": { "const": false },
        "remote_casc": { "const": false },
        "lock_sha256": { "const": null },
        "downloaded_bytes": { "const": 0 }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "incomplete_marker_present", "artifacts", "integrity"],
      "properties": {
        "root": { "const": "." },
        "incomplete_marker_present": { "type": "boolean" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "file_count", "total_bytes", "inventory_sha256"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "file_count": { "type": "integer", "minimum": 0 },
            "total_bytes": { "type": "integer", "minimum": 0 },
            "inventory_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "completed_at"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths_redacted", "client_data_embedded"],
      "properties": {
        "paths_redacted": { "const": true },
        "client_data_embedded": { "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "compatibility": {
            "properties": { "support": { "const": "experimental" } },
            "required": ["support"]
          }
        }
      },
      "then": {
        "properties": {
          "compatibility": {
            "properties": { "target_build": { "enum": [70170, 70205] } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "complete" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "outputs": {
            "properties": {
              "incomplete_marker_present": { "const": false },
              "artifacts": {
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/artifact" },
                    {
                      "properties": { "status": { "const": "complete" } },
                      "not": { "required": ["code"] }
                    }
                  ]
                }
              }
            }
          },
          "timestamps": {
            "properties": {
              "completed_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "else": {
        "required": ["reason"],
        "properties": {
          "reason": { "type": "string", "minLength": 1 },
          "outputs": {
            "properties": { "incomplete_marker_present": { "const": true } }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "locale": { "enum": ["enUS", "esES"] },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "file_id", "table_hash", "layout_hash", "meta_index_field", "field_count"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$" },
        "file_id": { "type": "integer", "minimum": 1 },
        "table_hash": { "type": "integer", "minimum": 0 },
        "layout_hash": { "type": "integer", "minimum": 0 },
        "meta_index_field": { "type": "integer" },
        "field_count": { "type": "integer", "minimum": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "file_id",
        "relative_path",
        "status",
        "bytes",
        "sha256",
        "declared_records",
        "table_schema_validated",
        "record_data_decoded",
        "decoded_rows"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$" },
        "file_id": { "type": "integer", "minimum": 1 },
        "relative_path": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}\\.db2$"
        },
        "status": { "enum": ["complete", "error"] },
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "declared_records": { "type": "integer", "minimum": 0 },
        "table_schema_validated": { "type": "boolean" },
        "record_data_decoded": { "type": "boolean" },
        "decoded_rows": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "error" } },
            "required": ["status"]
          },
          "then": { "required": ["code"] },
          "else": { "not": { "required": ["code"] } }
        },
        {
          "if": {
            "properties": { "record_data_decoded": { "const": true } },
            "required": ["record_data_decoded"]
          },
          "then": { "properties": { "decoded_rows": { "type": "integer", "minimum": 0 } } }
        }
      ]
    }
  }
}
