{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alseif0x/rustycore-extractors/schemas/forever-gt-manifest-v1.schema.json",
  "title": "Forever closed GT batch manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version","scope","status","product","build","locale","extractor","extractor_version","oracle_commit","plan","numeric_policy","max_file_bytes","max_batch_bytes","offline","downloaded_bytes","paths_redacted","full_client_extraction","typed_loaders_executed","artifacts","integrity"],
  "properties": {
    "manifest_version": {"const": 1},
    "scope": {"const": "explicit_gt_batch"},
    "status": {"enum": ["complete", "partial"]},
    "product": {"const": "wow_classic_beta"},
    "build": {"enum": [70170, 70205]},
    "locale": {"enum": ["enUS", "esES"]},
    "extractor": {"const": "forever-gt-extract"},
    "extractor_version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9.+-]+$"},
    "oracle_commit": {"const": "02245dcd245e7433e524577656177723d3e4992e"},
    "plan": {"enum": ["all", "initial", "spell-values"]},
    "numeric_policy": {"const": "finite_decimal_f64_to_f32_v1"},
    "max_file_bytes": {"const": 4194304},
    "max_batch_bytes": {"const": 25165824},
    "offline": {"const": true},
    "downloaded_bytes": {"const": 0},
    "paths_redacted": {"const": true},
    "full_client_extraction": {"const": false},
    "typed_loaders_executed": {"const": false},
    "artifacts": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"$ref": "#/$defs/artifact"}},
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["file_count", "total_bytes", "inventory_sha256"],
      "properties": {
        "file_count": {"type": "integer", "minimum": 0, "maximum": 6},
        "total_bytes": {"type": "integer", "minimum": 0, "maximum": 25165824},
        "inventory_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"plan": {"const": "all"}}}, "then": {"properties": {"artifacts": {"minItems": 6, "maxItems": 6}}}, "else": {"properties": {"artifacts": {"minItems": 3, "maxItems": 3}}}},
    {"if": {"properties": {"status": {"const": "complete"}}}, "then": {"properties": {"artifacts": {"items": {"properties": {"status": {"const": "complete"}}}}}}, "else": {"properties": {"artifacts": {"contains": {"properties": {"status": {"const": "error"}}}}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["name","file_id","relative_path","value_columns","status","bytes","sha256","data_rows","consumer_rows_including_zero","terminated_early","error_code"],
      "properties": {
        "name": {"enum": ["BaseMp","HpPerSta","xp","SpellScaling","CombatRatingsMultByILvl","StaminaMultByILvl"]},
        "file_id": {"enum": [1391664,1391642,1391661,1391660,1391670,1980632]},
        "relative_path": {"enum": ["gt/BaseMp.txt","gt/HpPerSta.txt","gt/xp.txt","gt/SpellScaling.txt","gt/CombatRatingsMultByILvl.txt","gt/StaminaMultByILvl.txt"]},
        "value_columns": {"enum": [1,4,5,15,24]},
        "status": {"enum": ["complete","error"]},
        "bytes": {"type": ["integer","null"], "minimum": 0, "maximum": 4194304},
        "sha256": {"anyOf": [{"$ref": "#/$defs/hash"},{"type": "null"}]},
        "data_rows": {"type": ["integer","null"], "minimum": 0, "maximum": 100000},
        "consumer_rows_including_zero": {"type": ["integer","null"], "minimum": 1, "maximum": 100001},
        "terminated_early": {"type": ["boolean","null"]},
        "error_code": {"type": ["string","null"], "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9_]+$"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "complete"}}}, "then": {"properties": {"bytes": {"type": "integer"}, "sha256": {"$ref": "#/$defs/hash"}, "data_rows": {"type": "integer"}, "consumer_rows_including_zero": {"type": "integer"}, "terminated_early": {"type": "boolean"}, "error_code": {"type": "null"}}}, "else": {"properties": {"bytes": {"type": "null"}, "sha256": {"type": "null"}, "data_rows": {"type": "null"}, "consumer_rows_including_zero": {"type": "null"}, "terminated_early": {"type": "null"}, "error_code": {"type": "string"}}}}
      ]
    }
  }
}
