{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alseif0x/rustycore-extractors/schemas/forever-camera-manifest-v2.schema.json",
  "title": "Forever raw camera files with explicit Rust local acquisition v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "scope",
    "status",
    "product",
    "build",
    "locale",
    "extractor",
    "extractor_version",
    "oracle_commit",
    "db2_metadata_sha256",
    "discovery_policy",
    "max_source_bytes",
    "max_file_bytes",
    "max_files",
    "max_total_bytes",
    "offline",
    "downloaded_bytes",
    "paths_redacted",
    "full_client_extraction",
    "m2_parsed",
    "waypoints_generated",
    "runtime_accepted",
    "source",
    "cameras",
    "integrity",
    "acquisition"
