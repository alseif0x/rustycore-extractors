{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alseif0x/rustycore-extractors/schemas/command-result-v1.schema.json",
  "title": "RustyCore Extractors command result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "command", "status", "exit_code", "run_id", "manifest", "summary", "details", "diagnostics"],
  "properties": {
    "contract_version": { "const": 1 },
    "command": { "enum": ["inspect", "extract", "verify"] },
    "status": { "enum": ["success", "partial", "failure"] },
    "exit_code": { "enum": [0, 2, 3, 4, 5, 6, 7, 8, 9, 10, 130] },
    "run_id": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        { "type": "null" }
      ]
    },
    "manifest": {
      "oneOf": [
        { "enum": ["data-manifest.json", ".rustycore-extractors-incomplete.json"] },
        { "type": "null" }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "completed_units", "total_units"],
      "properties": {
        "message": { "type": "string", "minLength": 1 },
        "completed_units": { "type": "integer", "minimum": 0 },
        "total_units": { "type": "integer", "minimum": 0 }
      }
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "plan", "output"],
      "properties": {
        "client": {
          "oneOf": [
            { "$ref": "#/$defs/client" },
            { "type": "null" }
          ]
        },
        "plan": {
          "oneOf": [
            { "$ref": "#/$defs/plan" },
            { "type": "null" }
          ]
        },
        "output": {
          "oneOf": [
            { "$ref": "#/$defs/output" },
            { "type": "null" }
          ]
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "severity": { "enum": ["info", "warning", "error"] },
          "message": { "type": "string", "minLength": 1 },
          "field": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "success" } }, "required": ["status"] },
      "then": { "properties": { "exit_code": { "const": 0 } } },
      "else": { "properties": { "exit_code": { "not": { "const": 0 } } } }
    }
  ],
  "$defs": {
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version", "build", "locales", "support"],
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "build": { "type": "integer", "minimum": 1 },
        "locales": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]{2}[A-Z]{2}$" }
        },
        "support": { "enum": ["supported", "unsupported", "experimental"] }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "estimated_disk_bytes", "estimated_duration_seconds", "estimated_work_units", "network_requests", "estimated_download_bytes"],
      "properties": {
        "components": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["dbc", "gt", "cameras", "maps", "vmaps", "mmaps"] }
        },
        "estimated_disk_bytes": { "$ref": "#/$defs/estimate" },
        "estimated_duration_seconds": { "$ref": "#/$defs/estimate" },
        "estimated_work_units": { "$ref": "#/$defs/estimate" },
        "network_requests": { "type": "integer", "minimum": 0 },
        "estimated_download_bytes": { "$ref": "#/$defs/estimate" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verified_files", "failed_files"],
      "properties": {
        "status": { "enum": ["complete", "incomplete", "failed"] },
        "verified_files": { "type": "integer", "minimum": 0 },
        "failed_files": { "type": "integer", "minimum": 0 }
      }
    },
    "estimate": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ]
    }
  }
}
